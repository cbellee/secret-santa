NODE_ENV=development
APP_ORIGIN=http://localhost:5173
PORT=3000
DATABASE_PATH=./data/santa.sqlite
# Must be RANDOM, not a guessable phrase (e.g. not "SmithXmas2026"). Generate with: openssl rand -hex 16
# Share privately. Minimum 12 characters is enforced, but length alone does not make a phrase safe.
GROUP_INVITE_CODE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v24.0
# Production only (Docker Compose): token from Cloudflare dashboard > Networking > Tunnels. Keep secret.
CLOUDFLARE_TUNNEL_TOKEN=
